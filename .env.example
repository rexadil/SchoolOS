# GEMINI_API_KEY: Required only if Gemini AI features are added server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------
# VERCEL / STATIC HOSTING FIREBASE WEB CONFIG (Multi-School Overrides)
# In AI Studio preview, `firebase-applet-config.json` is used automatically.
# For commercial Vercel deployments (1 Vercel project + 1 Firebase project per school),
# set all VITE_FIREBASE_* variables below in Vercel Project Settings -> Environment Variables.
# See DEPLOYMENT.md for the full step-by-step SOP.
# -----------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Standard new Firebase projects use "(default)". Override only if using a named Firestore DB.
VITE_FIREBASE_DATABASE_ID="(default)"

# Optional runtime label displayed in Owner-only System Info panel ("production" / "staging")
VITE_APP_ENV="production"

# -----------------------------------------------------------------
# FIREBASE APP CHECK (Public reCAPTCHA v3 Site Key)
# Safe for client bundle. Enable enforcement in Firebase Console first.
# -----------------------------------------------------------------
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# NOTE ON SMS GATEWAY SECRETS (SSL Wireless / MIMS / BulkSMSBD):
# NEVER place SMS API keys, tokens, or passwords in VITE_* variables or Firestore.
# Store SMS_API_KEY / SMS_API_SECRET strictly in Firebase Cloud Functions Secret Manager.
